# Stage 1: Build Next.js SSR app
FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS="--max-old-space-size=1536"

COPY package*.json ./
RUN npm ci

COPY . .
ARG NEXT_PUBLIC_API_URL=https://api.lastberth.com
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_APP_URL=https://lastberth.com
ENV NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NOTE: no quotes — Dockerfile ENV keeps quotes literally, and a quoted key
# makes PostHog reject every event (silent 0-events dashboard).
ENV NEXT_PUBLIC_POSTHOG_KEY=phc_dUWzTbfYH1T3LFOmPmWBefZbYGhB9Cfml5LS7G0oxl0
ENV NEXT_PUBLIC_GA_MEASUREMENT_ID=G-706EQLNFKR
ENV NEXT_PUBLIC_SENTRY_DSN=https://49577c5b11a73c67c2d5fcfd9865a587@o4511145941008384.ingest.us.sentry.io/4511145942712320
ENV NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
ENV NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2
RUN npm run build:web

# Stage 2: Production runner
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3010
# Server-side Sentry reporting (builder-stage ENVs do not propagate here).
ENV SENTRY_DSN=https://49577c5b11a73c67c2d5fcfd9865a587@o4511145941008384.ingest.us.sentry.io/4511145942712320
ENV SENTRY_ENVIRONMENT=production
ENV SENTRY_TRACES_SAMPLE_RATE=0.2

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/content ./content
COPY --from=builder /app/next.config.mjs ./next.config.mjs

EXPOSE 3010
CMD ["node", "--max-old-space-size=512", "node_modules/next/dist/bin/next", "start", "-p", "3010"]
