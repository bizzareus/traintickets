{
    # Global options
    email me@kartikarora.in
}

lastberth.com {
    log {
        output file /var/log/caddy/access.log {
            roll_size 20mb
            roll_keep 10
            roll_keep_for 240h # 10 days
        }
    }

    reverse_proxy frontend:3010 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto https
    }
}

www.lastberth.com {
    redir https://lastberth.com{uri} permanent
}

v2.lastberth.com {
    log {
        output file /var/log/caddy/access.log {
            roll_size 20mb
            roll_keep 10
            roll_keep_for 240h # 10 days
        }
    }

    reverse_proxy frontend:3010 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto https
    }
}
