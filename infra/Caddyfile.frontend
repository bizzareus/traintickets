{
    # Global options
    email me@kartikarora.in
}

# Domain Access with HTTPS for Cloudflare Full SSL
lastberth.com, www.lastberth.com, v2.lastberth.com {
    tls internal

    log {
        output file /var/log/caddy/access.log {
            roll_size 20mb
            roll_keep 10
            roll_keep_for 240h # 10 days
        }
    }

    reverse_proxy frontend:3010 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
    }
}
