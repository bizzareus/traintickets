    # Global options
    email me@kartikarora.in
}

# 1. Direct IP HTTP Access (port 80) for testing before DNS
:80 {
    log {
        output file /var/log/caddy/access.log {
            roll_size 20mb
            roll_keep 10
            roll_keep_for 240h # 10 days
        }
    }

    reverse_proxy backend:3009 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# 2. Domain Access with Automatic HTTPS (Let's Encrypt SSL) + Origin Restriction
api-v2.lastberth.com, api.lastberth.com {
    log {
        output file /var/log/caddy/access.log {
            roll_size 20mb
            roll_keep 10
            roll_keep_for 240h # 10 days
        }
    }

    # Block external cross-origin requests that do not come from lastberth.com or localhost
    @blockedOrigin {
        header Origin *
        not header Origin `https://lastberth.com`
        not header Origin `https://*.lastberth.com`
        not header Origin `http://localhost*`
        not header Origin `http://127.0.0.1*`
    }
    respond @blockedOrigin "403 Forbidden: Origin not allowed" 403

    reverse_proxy backend:3009 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
