#!/bin/bash
# Pre-commit hook to run happy flow and quick sanity checks

if command -v node >/dev/null 2>&1; then
  : # node is already in PATH
elif [ -s "$HOME/.nvm/nvm.sh" ]; then
  export NVM_DIR="$HOME/.nvm"
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
fi

echo "🎨 [pre-commit] Formatting staged files with Prettier..."
cd "$(git rev-parse --show-toplevel)"
if [ ! -x "./node_modules/.bin/prettier" ]; then
  echo "⚠️ [pre-commit] Prettier not installed at root (run npm install). Skipping format."
else
  files=()
  while IFS= read -r f; do
    case "$f" in
      *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.json|*.md|*.mdx|*.css|*.yml|*.yaml)
        files+=("$f")
        ;;
    esac
  done < <(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n')
  if [ ${#files[@]} -gt 0 ]; then
    ./node_modules/.bin/prettier --write --log-level warn "${files[@]}"
    RESULT=$?
    if [ $RESULT -ne 0 ]; then
      echo "❌ [pre-commit] Prettier failed. Commit aborted. Fix the issue or use --no-verify to skip."
      exit 1
    fi
    git add -- "${files[@]}"
    echo "✅ [pre-commit] Staged files formatted."
  else
    echo "⏭️ [pre-commit] No formattable staged files."
  fi
fi

echo "🔍 [pre-commit] Running API Build check..."
npm run build:api
RESULT=$?
if [ $RESULT -ne 0 ]; then
  echo "❌ [pre-commit] API build failed. Commit aborted. Fix the issue or use --no-verify to skip."
  exit 1
fi

echo "✅ [pre-commit] Checks passed. Proceeding with commit..."
exit 0
