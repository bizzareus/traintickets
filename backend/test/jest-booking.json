{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "modulePathIgnorePatterns": ["<rootDir>/dist/"],
  "testRegex": "test/booking-(contract|persistence)\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
  },
  "moduleNameMapper": {
    "^got-scraping$": "<rootDir>/src/__mocks__/got-scraping"
  }
}
