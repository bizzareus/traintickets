generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  phone              String?
  passwordHash       String              @map("password_hash")
  createdAt          DateTime            @default(now()) @map("created_at")
  monitoringRequests MonitoringRequest[]
}

model Train {
  id                  String               @id @default(cuid())
  trainNumber         String               @unique @map("train_number")
  trainName           String               @map("train_name")
  originStation       String               @map("origin_station")
  destinationStation  String               @map("destination_station")
  departureTime       String?              @map("departure_time")
  arrivalTime         String?              @map("arrival_time")
  active              Boolean              @default(true)
  chartEventInstances ChartEventInstance[]
  monitoringRequests  MonitoringRequest[]
  chartRules          ChartRule[]
}

model ChartEventInstance {
  id                String             @id @default(cuid())
  trainId           String             @map("train_id")
  stationCode       String             @map("station_code")
  journeyDate       DateTime           @map("journey_date") @db.Date
  chartTimestamp    DateTime           @map("chart_timestamp")
  sequenceNumber    Int                @map("sequence_number")
  executed          Boolean            @default(false)
  executedAt        DateTime?          @map("executed_at")
  browserExecutions BrowserExecution[]
  train             Train              @relation(fields: [trainId], references: [id], onDelete: Cascade)

  @@index([chartTimestamp, executed])
  @@index([trainId, stationCode, journeyDate])
}

model ChartRule {
  id             String  @id @default(cuid())
  trainId        String  @map("train_id")
  stationCode    String  @map("station_code")
  chartTimeLocal String  @map("chart_time_local")
  sequenceNumber Int     @map("sequence_number")
  active         Boolean @default(true)
  train          Train   @relation(fields: [trainId], references: [id], onDelete: Cascade)

  // Covers the previously-unindexed train_id FK and the hot
  // `WHERE train_id IN (...) ORDER BY sequence_number` lookup.
  @@index([trainId, sequenceNumber])
}

model MonitoringRequest {
  id                String                  @id @default(cuid())
  userId            String                  @map("user_id")
  trainId           String                  @map("train_id")
  stationCode       String                  @map("station_code")
  journeyDate       DateTime                @map("journey_date") @db.Date
  classCode         String                  @map("class_code")
  status            MonitoringRequestStatus @default(scheduled)
  createdAt         DateTime                @default(now()) @map("created_at")
  alertLogs         AlertLog[]
  browserExecutions BrowserExecution[]
  train             Train                   @relation(fields: [trainId], references: [id], onDelete: Cascade)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([trainId, stationCode, journeyDate, status])
}

model BrowserExecution {
  id                   String                 @id @default(cuid())
  monitoringRequestId  String                 @map("monitoring_request_id")
  chartEventInstanceId String                 @map("chart_event_instance_id")
  jobId                String?                @map("job_id")
  type                 BrowserExecutionType   @default(availability)
  status               BrowserExecutionStatus @default(pending)
  resultPayload        Json?                  @map("result_payload")
  createdAt            DateTime               @default(now()) @map("created_at")
  completedAt          DateTime?              @map("completed_at")
  chartEventInstance   ChartEventInstance     @relation(fields: [chartEventInstanceId], references: [id], onDelete: Cascade)
  monitoringRequest    MonitoringRequest      @relation(fields: [monitoringRequestId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model TrainList {
  id                     String  @id @default(cuid())
  trainNumber            String  @unique @map("train_number")
  label                  String
  chartTimeIngestionDone Boolean @default(false) @map("chart_time_ingestion_done")

  @@index([trainNumber])
  @@index([label])
  @@index([chartTimeIngestionDone])
}

model TrainScheduleCache {
  id          String   @id @default(cuid())
  trainNumber String   @unique @map("train_number")
  trainName   String   @map("train_name")
  stationFrom String   @map("station_from")
  stationTo   String   @map("station_to")
  stationList Json     @map("station_list")
  fetchedAt   DateTime @default(now()) @map("fetched_at")
  /// IRCTC schedule: trainRunsOnMon..Sun as "Y"|"N" (JSON object)
  trainRunsOn Json?    @map("train_runs_on")
  /// Travel classes the train offers (e.g. ["SL","3A","2A","1A"]); used to probe
  /// only real classes in alternate-paths instead of all possible classes.
  availableClasses String[] @default([]) @map("available_classes")

  @@index([trainNumber])
}

model TrainStationChartTime {
  id                String   @id @default(cuid())
  trainNumber       String   @map("train_number")
  stationCode       String   @map("station_code")
  chartTimeLocal    String   @map("chart_time_local")
  createdAt         DateTime @default(now()) @map("created_at")
  chartTwoDayOffset Int?     @map("chart_two_day_offset")
  chartTwoTimeLocal String?  @map("chart_two_time_local")
  chartOneDayOffset      Int?     @map("chart_one_day_offset")
  chartRemoteStation     String?  @map("chart_remote_station")
  chartNextRemoteStation String?  @map("chart_next_remote_station")

  @@unique([trainNumber, stationCode])
  @@index([trainNumber])
  @@index([stationCode])
}

model MonitoringContact {
  id                        String                     @id @default(cuid())
  email                     String?                    @unique @db.VarChar(255)
  mobile                    String?                    @db.VarChar(20)
  createdAt                 DateTime                   @default(now()) @map("created_at")
  journeyMonitoringRequests JourneyMonitoringRequest[]

  @@index([email])
  @@index([mobile])
}

model JourneyMonitoringRequest {
  id                  String             @id @default(cuid())
  monitoringContactId String?            @map("monitoring_contact_id")
  trainNumber         String             @map("train_number")
  fromStationCode     String             @map("from_station_code")
  toStationCode       String             @map("to_station_code")
  journeyDate         DateTime           @map("journey_date") @db.Date
  classCode           String             @map("class_code")
  createdAt           DateTime           @default(now()) @map("created_at")
  monitoringContact   MonitoringContact? @relation(fields: [monitoringContactId], references: [id])

  @@index([monitoringContactId])
  @@index([trainNumber, journeyDate])
}

model JourneyMonitorContact {
  id               String   @id @default(cuid())
  journeyRequestId String   @unique @map("journey_request_id")
  email            String?  @db.VarChar(255)
  mobile           String?  @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([journeyRequestId])
  tasks            ChartTimeAvailabilityTask[]
}

model ChartTimeAvailabilityTask {
  id                 String    @id @default(cuid())
  journeyRequestId   String    @map("journey_request_id")
  trainNumber        String    @map("train_number")
  trainName          String?   @map("train_name")
  fromStationCode    String    @map("from_station_code")
  toStationCode      String    @map("to_station_code")
  stationCode        String    @map("station_code")
  journeyDate        DateTime  @map("journey_date") @db.Date
  trainStartDate     DateTime? @map("train_start_date") @db.Date
  chartAt            DateTime  @map("chart_at")
  status             String    @default("pending")
  resultPayload      Json?     @map("result_payload")
  retryCount         Int       @default(0) @map("retry_count")
  nextRunAt          DateTime? @map("next_run_at")
  lockedAt           DateTime? @map("locked_at")
  lastError          String?   @map("last_error")
  firstRunAt         DateTime? @map("first_run_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  completedAt        DateTime? @map("completed_at")
  emailNotifiedAt    DateTime? @map("email_notified_at")
  whatsappNotifiedAt DateTime? @map("whatsapp_notified_at")

  contact JourneyMonitorContact? @relation(fields: [journeyRequestId], references: [journeyRequestId])

  @@index([chartAt, status])
  @@index([status, nextRunAt, lockedAt])
  @@index([journeyRequestId])
}

model CronLease {
  name      String   @id
  ownerId   String   @map("owner_id")
  expiresAt DateTime @map("expires_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("CronLease")
}

model AvailabilityCheck {
  id            String    @id @default(cuid())
  jobId         String?   @unique @map("job_id")
  trainNumber   String    @map("train_number")
  stationCode   String    @map("station_code")
  classCode     String    @map("class_code")
  journeyDate   DateTime  @map("journey_date") @db.Date
  status        String    @default("pending")
  resultPayload Json?     @map("result_payload")
  createdAt     DateTime  @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")

  @@index([jobId])
}

model AlertLog {
  id                  String            @id @default(cuid())
  monitoringRequestId String            @map("monitoring_request_id")
  channel             AlertChannel
  status              AlertLogStatus
  createdAt           DateTime          @default(now()) @map("created_at")
  monitoringRequest   MonitoringRequest @relation(fields: [monitoringRequestId], references: [id], onDelete: Cascade)

  @@index([monitoringRequestId])
}

model CacheEntry {
  key       String    @id
  value     Json
  expiresAt DateTime? @map("expires_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("cache_entry")
}

/**
 * Precomputed route-level cache written by background crons (never on the request
 * path). Keyed by an opaque string from a per-cache-type key builder; `value` is a
 * small trimmed result blob. Backs the reusable RouteCacheStore pattern — new cache
 * families (e.g. class-level) get their own table reusing that base.
 */
model RouteCaching {
  cacheKey  String   @id @map("cache_key")
  value     Json
  cachedAt  DateTime @default(now()) @map("cached_at")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("route_caching")
}

/**
 * One row per best-seats cron tick that did work — powers the admin dashboard
 * view of when the cron ran, its outcome counts, and which routes it updated.
 * `routes` is a JSON array of { from, to, date, status, train } for the batch.
 */
model BestSeatsCronRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  durationMs Int?      @map("duration_ms")
  due        Int
  batch      Int
  refreshed  Int
  failed     Int
  skipped    Int
  routes     Json
  ownerId    String?   @map("owner_id")

  @@index([startedAt])
  @@map("best_seats_cron_run")
}

model StationCache {
  stationCode String   @id @map("station_code")
  stationName String   @map("station_name")
  metadata    Json
  updatedAt   DateTime @updatedAt @map("updated_at")

  // station_name index dropped: searches use ILIKE '%term%' (leading wildcard)
  // which a B-tree can't serve, so it was never used and only added write cost.
  @@map("station_cache")
}

enum MonitoringRequestStatus {
  scheduled
  completed
  expired
}

enum BrowserExecutionType {
  availability
}

enum BrowserExecutionStatus {
  pending
  running
  success
  failed
}

enum AlertChannel {
  whatsapp
  call
  push
}

enum AlertLogStatus {
  sent
  failed
}
model RedditAnalyzedComment {
  id               String   @id @map("id")
  content          String   @map("content")
  author           String   @map("author")
  permalink        String   @map("permalink")
  trainNumber      String?  @map("train_number")
  origin           String?  @map("origin")
  destination      String?  @map("destination")
  pnr              String?  @map("pnr")
  dateOfTravel     String?  @map("date_of_travel")
  currentStatus    String?  @map("current_status")
  rawJson          Json?    @map("raw_json")
  screenshotUrl    String?  @map("screenshot_url")
  status           String   @default("PENDING") @map("status")
  createdAt        DateTime @default(now()) @map("created_at")
  analyzedAt       DateTime? @map("analyzed_at")

  @@index([trainNumber])
  @@index([pnr])
  @@map("reddit_analyzed_comments")
}




/// Shared, single-row store for the harvested IRCTC cookie bundle so all
/// Railway replicas read the same cookie, plus a lock so only one replica
/// harvests per cycle. Managed by IrctcCookieStoreService / the session keeper.
model IrctcSession {
  id              String    @id
  cookie          String    @default("") @db.Text
  source          String?
  cookieUpdatedAt DateTime? @map("cookie_updated_at")
  harvestLockedAt DateTime? @map("harvest_locked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("irctc_session")
}

/// Full trainComposition JSON cached per train number, refreshed at most every
/// 4 weeks. Serves the frontend coach-list loader when IRCTC is flaky/slow and
/// avoids re-hitting IRCTC for the (largely static) coach layout. See
/// IrctcService.getTrainComposition (cacheByTrainNumber path).
model TrainCompositionCache {
  trainNumber String   @id @map("train_number")
  data        Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("train_composition_cache")
}

/// One row per run (tick) of a scheduled cron, capturing when it actually fired,
/// how long it took, and the input/output of that run. Used to debug the
/// chart-notification cron (ChartCronService -> JourneyTaskService.runDueTasks):
/// it "never runs on time / always has issues", so we track every leader tick.
model CronRunLog {
  id             String    @id @default(cuid())
  cronName       String    @map("cron_name")
  startedAt      DateTime  @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  durationMs     Int?      @map("duration_ms")
  /// success | error | skipped_overlap
  status         String
  isLeader       Boolean   @default(false) @map("is_leader")
  tasksClaimed   Int       @default(0) @map("tasks_claimed")
  tasksRun       Int       @default(0) @map("tasks_run")
  completedCount Int       @default(0) @map("completed_count")
  failedCount    Int       @default(0) @map("failed_count")
  /// { istNow, claimedTaskIds, ... }
  input          Json?
  /// { perTask: [{ taskId, trainNumber, from, to, status, lastError }], ... }
  output         Json?
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([cronName, startedAt])
  @@map("cron_run_log")
}

/// Stores short link code and associated payload (e.g. for auto-subscribing alert parameters).
model ShortLink {
  id            String           @id @default(cuid())
  code          String           @unique
  url           String?          @db.Text
  payload       Json?
  clickCount    Int              @default(0) @map("click_count")
  lastClickedAt DateTime?        @map("last_clicked_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  expiresAt     DateTime?        @map("expires_at")
  clicks        ShortLinkClick[]

  @@map("short_link")
}

/// Tracks individual click events on short links with timestamp, user agent, and network origin.
model ShortLinkClick {
  id          String    @id @default(cuid())
  shortLinkId String    @map("short_link_id")
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  clickedAt   DateTime  @default(now()) @map("clicked_at")
  userAgent   String?   @map("user_agent")
  ipAddress   String?   @map("ip_address")
  referer     String?   @map("referer")
  metadata    Json?

  @@index([shortLinkId, clickedAt])
  @@map("short_link_click")
}

/// Stores background alternative train search jobs triggered when a chart task notification finds no full-journey ticket.
model AlternativeSearchTask {
  id                  String    @id @default(cuid())
  journeyTaskId       String?   @map("journey_task_id")
  trainNumber         String    @map("train_number")
  trainName           String?   @map("train_name")
  fromStationCode     String    @map("from_station_code")
  toStationCode       String    @map("to_station_code")
  journeyDate         DateTime  @map("journey_date") @db.Date
  classCode           String    @default("3A") @map("class_code")
  monitoringContactId String?   @map("monitoring_contact_id")
  email               String?
  mobile              String?
  status              String    @default("pending") // pending | processing | completed | no_alternatives_found | failed
  resultPayload       Json?     @map("result_payload")
  notificationSent    Boolean   @default(false) @map("notification_sent")
  createdAt           DateTime  @default(now()) @map("created_at")
  processedAt         DateTime? @map("processed_at")
  lastError           String?   @map("last_error")

  @@index([status, createdAt])
  @@map("alternative_search_task")
}

/// Tracks sent notifications to deduplicate and prevent redundant/spam notifications for the same train & date.
model SentNotificationLog {
  id               String   @id @default(cuid())
  recipient        String   @map("recipient")
  channel          String   @map("channel")
  trainNumber      String   @map("train_number")
  journeyDate      DateTime @map("journey_date") @db.Date
  notificationType String   @map("notification_type")
  sentAt           DateTime @default(now()) @map("sent_at")

  @@index([recipient, trainNumber, journeyDate, notificationType, sentAt])
  @@map("sent_notification_log")
}

/// Tracks users who opted out of notifications. Keyed by normalized recipient
/// (lowercase email or E.164 mobile). The cron task-pickup query JOINs against
/// this table to skip unsubscribed contacts entirely; NotificationService also
/// checks it as a defence-in-depth guard before sending.
model NotificationUnsubscribe {
  id        String   @id @default(cuid())
  recipient String   @unique               // normalized email or E.164 mobile
  channel   String   @default("all")       // "all" | "email" | "whatsapp"
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([recipient])
  @@map("notification_unsubscribe")
}
